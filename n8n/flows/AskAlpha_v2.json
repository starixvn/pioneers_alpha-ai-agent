    {
      "parameters": {
        "name": "AikoData",
        "description": "Stores internal knowledge. Use vector search to retrieve the most relevant information in order to accurately answer the user's question.",
        "topK": 1
      },
      "type": "@n8n/n8n-nodes-langchain.toolVectorStore",
      "typeVersion": 1,
