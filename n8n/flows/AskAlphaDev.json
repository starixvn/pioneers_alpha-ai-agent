          "metadata": {
            "metadataValues": [
              {
                "name": "=level",
                "value": "={{(() => {\n  const mapping = {\n    1: 'member',\n    2: 'agent',\n    3: 'master',\n    4: 'super'\n  };\n\n  const steps = ['Edit Fields', 'Edit Fields2', 'Edit Fields1'];\n  for (const step of steps) {\n    if ($(step).isExecuted) {\n      const roleId = $(step).item.json.roleId;\n      return mapping[roleId] || 'unknown';\n    }\n  }\n\n  return 'unknown';\n})()}}"
              },
              {
                "name": "market",
                "value": "={{(() => {\n  const steps = ['Edit Fields', 'Edit Fields2', 'Edit Fields1'];\n  for (const step of steps) {\n    if ($(step).isExecuted) {\n      const system = $(step).item.json.system;\n      return system ? system.toLowerCase() : \"\";\n    }\n  }\n  return \"\";\n})()}}"
              }
            ]
          }
        }
